{
  "name": "serve-emu-monorepo",
  "private": true,
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "bun run --filter '@expo/serve-emu' dev",
    "build": "bun run --filter '@expo/serve-emu' build",
    "test": "bun run --filter '@expo/serve-emu' test",
    "typecheck": "bun run --filter '@expo/serve-emu' typecheck && bun run --filter '@expo/serve-emu' typecheck:ui"
  },
  "trustedDependencies": [
    "node-datachannel"
  ],
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/bun": "latest"
  }
}
